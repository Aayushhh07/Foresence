COPERNICUS_USERNAME=your_copernicus_username
COPERNICUS_PASSWORD=your_copernicus_password
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/
DB_NAME=foresence
CLOUDFLARE_R2_ACCESS_KEY=your_r2_access_key
CLOUDFLARE_R2_SECRET_KEY=your_r2_secret_key
CLOUDFLARE_R2_BUCKET_NAME=foresence-images
CLOUDFLARE_R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
CLOUDFLARE_R2_PUBLIC_URL=https://pub-xxxx.r2.dev
UPSTASH_REDIS_URL=rediss://default:password@your-redis.upstash.io:6380
SENDGRID_API_KEY=SG.your_sendgrid_api_key
ALERT_FROM_EMAIL=alerts@yourdomain.com
SCAN_INTERVAL_HOURS=12
NDVI_DROP_THRESHOLD=0.15
CONFIDENCE_THRESHOLD=0.70
CORS_ORIGINS=http://localhost:5173,https://your-project.vercel.app
FRONTEND_URL=http://localhost:5173

# Production / Render
APP_MODE=prod
ENABLE_DEMO_ROUTES=true
ENABLE_PREDEFINED_ZONES=false
