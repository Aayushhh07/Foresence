COPERNICUS_USERNAME=your_copernicus_username
COPERNICUS_PASSWORD=your_copernicus_password
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/
DB_NAME=foresence
CLOUDFLARE_R2_ACCESS_KEY=your_r2_access_key
CLOUDFLARE_R2_SECRET_KEY=your_r2_secret_key
CLOUDFLARE_R2_BUCKET_NAME=foresence-images
CLOUDFLARE_R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
CLOUDFLARE_R2_PUBLIC_URL=https://pub-xxxx.r2.dev
UPSTASH_REDIS_URL=rediss://default:password@your-redis.upstash.io:6380

# ── Email (free options) ─────────────────────────────────────────────
# Option A — Resend (recommended, 100 emails/day free): https://resend.com
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_resend_api_key
ALERT_FROM_EMAIL=onboarding@resend.dev
ALERT_FROM_NAME=Foresence Alerts

# Option B — SMTP e.g. Brevo (300 emails/day free): https://www.brevo.com
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USERNAME=your_brevo_login_email
# SMTP_PASSWORD=your_brevo_smtp_key
# SMTP_USE_TLS=true
# ALERT_FROM_EMAIL=your_verified_sender@yourdomain.com

GLOBAL_ALERT_EMAILS=you@email.com
AUTO_EMAIL_ON_ALERT=true

SCAN_INTERVAL_HOURS=12
NDVI_DROP_THRESHOLD=0.15
CONFIDENCE_THRESHOLD=0.70
CORS_ORIGINS=http://localhost:5173,https://your-project.vercel.app
FRONTEND_URL=http://localhost:5173

APP_MODE=prod
ENABLE_DEMO_ROUTES=false
ENABLE_PREDEFINED_ZONES=true
